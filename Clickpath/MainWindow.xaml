<Window x:Class="Clickpath.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Clickpath.Models"
        xmlns:loc="clr-namespace:Clickpath.Localization"
        Title="Clickpath" Icon="pack://application:,,,/Assets/app.ico" Width="1840" Height="940" MinWidth="1000" MinHeight="640" WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LabelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecordToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentLabelButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogRow" Height="46" MinHeight="0" />
        </Grid.RowDefinitions>

        <!-- Browser bar -->
        <Border x:Name="BrowserBar" Grid.Row="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,10">
            <DockPanel>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" DockPanel.Dock="Left" Click="OnBack" ToolTip="{loc:T Tip.Back}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" />
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" DockPanel.Dock="Left" Click="OnForward" ToolTip="{loc:T Tip.Forward}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" />
                </Button>
                <Button Style="{StaticResource IconButton}" DockPanel.Dock="Left" Click="OnReload" ToolTip="{loc:T Tip.Reload}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                </Button>
                <Button x:Name="AppMenuButton" Style="{StaticResource IconButton}" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnAppMenu" ToolTip="{loc:T Tip.AppMenu}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" />
                </Button>
                <ToggleButton x:Name="AdBlockButton" Style="{StaticResource IconToggle}" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnAdBlockToggle" PreviewMouseRightButtonUp="OnAdBlockMenu" ToolTip="{loc:T Tip.AdBlock}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" />
                </ToggleButton>
                <Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnNewTab" ToolTip="{loc:T Tip.NewTab}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                </Button>
                <Button x:Name="HistoryButton" Style="{StaticResource IconButton}" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnHistory" ToolTip="{loc:T Tip.History}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" />
                </Button>
                <Button x:Name="ZoomButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="60" Margin="4,0,0,0" Click="OnZoomMenu" ToolTip="{loc:T Tip.Zoom}">
                    <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" />
                </Button>
                <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=AddressBox}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnHistoryClosed">
                    <Border x:Name="HistoryPanel" Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            Padding="0" CornerRadius="0,0,8,8">
                      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,0,7,7">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="0,0,7,7" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Click="OnClearHistory" Padding="12,5" Margin="8,0,0,0" Content="{loc:T History.Clear}" />
                                <TextBox x:Name="HistoryFilter" Background="Transparent" TextChanged="OnHistoryFilter" PreviewKeyDown="OnHistoryKeyDown" ToolTip="{loc:T History.Filter}" />
                            </DockPanel>
                            <TextBlock x:Name="HistoryEmpty" Text="{loc:T History.Empty}" Style="{StaticResource Caption}" Visibility="Collapsed" />
                            <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnHistoryPick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        </Border>
                      </Border>
                    </Border>
                </Popup>
                <TextBox x:Name="AddressBox" Height="34" Margin="4,0,0,0" VerticalContentAlignment="Center" KeyDown="OnAddressKeyDown"
                         PreviewKeyDown="OnAddressPreviewKeyDown" PreviewMouseLeftButtonDown="OnAddressMouseDown" GotKeyboardFocus="OnAddressFocus"
                         TextChanged="OnAddressTextChanged" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="480" MaxWidth="620" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: playback, steps, settings -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.4*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DetailRow" Height="0" MinHeight="0" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RunAllButton" Style="{StaticResource AccentLabelButton}" Padding="9,7" HorizontalAlignment="Stretch" Click="OnRunAll">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{loc:T Run.All}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="RunSelectedButton" Grid.Column="1" Style="{StaticResource LabelButton}" Padding="9,7" HorizontalAlignment="Stretch" Click="OnRunSelected" ToolTip="{loc:T Run.StepTip}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{loc:T Run.Step}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource LabelButton}" Padding="9,7" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnStop" ToolTip="{loc:T Run.Stop}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{loc:T Run.Stop}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <ToggleButton x:Name="RecordButton" Grid.Column="3" Style="{StaticResource RecordToggle}" Padding="9,7" HorizontalAlignment="Stretch" Margin="0" Checked="OnRecordToggle" Unchecked="OnRecordToggle" ToolTip="{loc:T Tip.Record}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Ellipse Width="12" Height="12" Fill="#E5484D" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{loc:T Rec.Start}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                        </Grid>
                        <TextBlock x:Name="RecordHint" Text="{loc:T Rec.Hint}" Style="{StaticResource Caption}" Visibility="Collapsed" />
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox x:Name="ShowClicksBox" Content="{loc:T Run.ShowClicks}" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:T Run.Pause}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="PauseBox" Text="0" Width="70" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="RunStatus" Margin="0,10,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button x:Name="PlanMenuButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="0" Click="OnPlanMenu"
                                    ToolTip="{loc:T Tip.PlanMenu}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" />
                            </Button>
                            <TextBlock Text="{loc:T Steps.Title}" Style="{StaticResource SectionTitle}" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddStepButton" Style="{StaticResource AccentLabelButton}" Click="OnAddStepMenu" ToolTip="{loc:T Steps.AddTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T Steps.Add}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteStepButton" Style="{StaticResource LabelButton}" Click="OnDeleteStep" ToolTip="{loc:T Tip.Delete}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T Btn.DeleteStep}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TreeView x:Name="StepTree" BorderThickness="0" Background="Transparent" SelectedItemChanged="OnStepSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseLeftButtonDown="OnStepMouseDown" PreviewMouseLeftButtonUp="OnStepMouseUp" PreviewKeyDown="OnStepKeyDown"
                                  PreviewMouseMove="OnStepDragMove" AllowDrop="True"
                                  DragOver="OnStepDragOver" DragLeave="OnStepDragLeave" Drop="OnStepDrop">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type m:Step}" ItemsSource="{Binding Children}">
                                    <Grid Margin="0,4" Tag="StepRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,5,0,0" MinWidth="320" Visibility="{Binding HasCountdown, Converter={StaticResource B2V}}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontSize="12" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding CountdownIndeterminate, Mode=OneWay}" Height="4" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding ChangeText}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasChangeText, Converter={StaticResource B2V}}" />
                                        </StackPanel>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter Property="Background" Value="#402F8CFF" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                                <Condition Binding="{Binding CanHaveChildren}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#3324A148" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="DetailSplitter" Grid.Row="2" Height="10" Background="Transparent" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />

                <Border x:Name="DetailCard" Grid.Row="3" Style="{StaticResource Card}" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <StackPanel x:Name="DetailHeader" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Icon}" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"
                                       Visibility="{Binding ShowsPlainTitle, Converter={StaticResource B2V}}" />
                            <ComboBox ItemsSource="{x:Static m:Options.GroupTypes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Type, Mode=OneWay}" SelectionChanged="OnGroupTypeChanged" MinWidth="280"
                                      ToolTip="{loc:T Tip.GroupType}" Visibility="{Binding UsesTypeSwitch, Converter={StaticResource B2V}}" />
                        </StackPanel>
                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="Properties" Margin="0,0,8,0">
                                <StackPanel Visibility="{Binding UsesUrl, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.Url}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding UsesMatch, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.Target}" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{x:Static m:Options.Targets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Target}" HorizontalAlignment="Stretch" />

                                    <StackPanel Visibility="{Binding UsesCss, Converter={StaticResource B2V}}">
                                        <TextBlock Text="{loc:T Field.Css}" Style="{StaticResource Caption}" />
                                        <TextBox Text="{Binding Selector, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                    </StackPanel>

                                    <TextBlock Text="{loc:T Field.Text}" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{x:Static m:Options.Matches}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding MatchMode}" HorizontalAlignment="Stretch" />
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                    <TextBlock Text="{loc:T Hint.TextEmpty}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    <TextBlock Text="{loc:T Hint.Vars}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    <CheckBox Content="{loc:T Field.MatchCase}" IsChecked="{Binding MatchCase}" Margin="0,6,0,0" />

                                    <TextBlock Text="{loc:T Field.Near}" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                                    <TextBox Text="{Binding NearText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{loc:T Hint.Near}" Style="{StaticResource Caption}" Margin="0,4,0,0" />

                                    <StackPanel Visibility="{Binding UsesClickEachMatch, Converter={StaticResource B2V}}">
                                        <CheckBox Content="{loc:T Opt.ClickEachMatch}" IsChecked="{Binding ClickEachMatch}" Margin="0,12,0,0" />
                                        <TextBlock Text="{loc:T Hint.ForEachElement}" Style="{StaticResource Caption}" Margin="0,4,0,0" />

                                        <TextBlock Text="{loc:T Field.Until}" Style="{StaticResource Caption}" Margin="0,16,0,4" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{x:Static m:Options.Matches}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding UntilMode}" HorizontalAlignment="Stretch" />
                                        <TextBox Text="{Binding UntilText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                        <TextBlock Text="{loc:T Field.UntilWait}" Style="{StaticResource Caption}" />
                                        <TextBox Text="{Binding UntilWaitMs, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                                        <TextBlock Text="{loc:T Hint.Until}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource LabelButton}" Click="OnPick" ToolTip="{loc:T Tip.Pick}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C9;" Margin="0,0,8,0" />
                                                <TextBlock Text="{loc:T Btn.Pick}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource LabelButton}" Click="OnShowMatches" ToolTip="{loc:T Tip.Show}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B3;" Margin="0,0,8,0" />
                                                <TextBlock Text="{loc:T Btn.Show}" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding UsesLinkList, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.LinkList}" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Style="{StaticResource LabelButton}" Padding="10,5" Content="{loc:T Btn.PasteLinks}" Click="OnPasteLinks" ToolTip="{loc:T Tip.PasteLinks}" />
                                        <Button Style="{StaticResource LabelButton}" Padding="10,5" Content="{loc:T Btn.LinksFromResults}" Click="OnLinksFromResults" ToolTip="{loc:T Tip.LinksFromResults}" />
                                        <Button Style="{StaticResource LabelButton}" Padding="10,5" Content="{loc:T Btn.TidyLinks}" Click="OnTidyLinks" ToolTip="{loc:T Tip.TidyLinks}" />
                                        <Button Style="{StaticResource LabelButton}" Padding="10,5" Content="{loc:T Btn.ClearLinks}" Click="OnClearLinks" />
                                    </WrapPanel>
                                    <TextBox Text="{Binding Links, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="110" MaxHeight="320"
                                             FontFamily="Consolas" SpellCheck.IsEnabled="False" PreviewMouseLeftButtonDown="OnLinkListMouseDown" />
                                    <TextBlock Text="{Binding LinkListSummary}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                    <TextBlock Text="{loc:T Hint.LinkList}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding UsesForEachOptions, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.Range}" Style="{StaticResource Caption}" Margin="0,16,0,0" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:T Field.StartAt}" Style="{StaticResource Caption}" Margin="0,4,0,4" />
                                    <ComboBox ItemsSource="{x:Static m:Options.Matches}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding StartMode}" HorizontalAlignment="Stretch" />
                                    <TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                    <TextBlock Text="{loc:T Field.StopAfter}" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                                    <ComboBox ItemsSource="{x:Static m:Options.Matches}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding EndMode}" HorizontalAlignment="Stretch" />
                                    <TextBox Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                    <TextBlock Text="{loc:T Hint.Range}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    <CheckBox Content="{loc:T Opt.Paginate}" IsChecked="{Binding Paginate}" Margin="0,12,0,0" />
                                    <StackPanel Visibility="{Binding UsesPaginationOptions, Converter={StaticResource B2V}}">
                                        <TextBlock Text="{loc:T Field.NextText}" Style="{StaticResource Caption}" />
                                        <TextBox Text="{Binding NextPageText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{loc:T Field.MaxPages}" Style="{StaticResource Caption}" />
                                        <TextBox Text="{Binding MaxPages, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Content="{loc:T Opt.NewTabOpen}" IsChecked="{Binding NewTab}" Margin="0,12,0,0"
                                          Visibility="{Binding UsesNewTab, Converter={StaticResource B2V}}" />
                                <StackPanel Visibility="{Binding UsesNewWindow, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.NewWindow}" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{x:Static m:Options.NewWindowModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding NewWindowMode}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <CheckBox Content="{loc:T Opt.KeepPages}" IsChecked="{Binding KeepOpenPages}" Margin="0,12,0,0"
                                          Visibility="{Binding UsesKeepOpenPages, Converter={StaticResource B2V}}" />
                                <TextBlock Text="{loc:T Hint.KeepPages}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding UsesKeepOpenPages, Converter={StaticResource B2V}}" />
                                <CheckBox Content="{loc:T Opt.HumanMouse}" IsChecked="{Binding HumanMouse}" Margin="0,12,0,0"
                                          Visibility="{Binding UsesHumanMouse, Converter={StaticResource B2V}}" />
                                <CheckBox Content="{loc:T Opt.RandomClicks}" IsChecked="{Binding RandomClicks}" Margin="0,12,0,0"
                                          Visibility="{Binding UsesRandomClicks, Converter={StaticResource B2V}}" />
                                <StackPanel Visibility="{Binding UsesClickRate, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.ClickEvery}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding ClickEveryMs, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Content="{loc:T Opt.EndOnNewPage}" IsChecked="{Binding EndOnNewPage}" Margin="0,12,0,0"
                                          Visibility="{Binding UsesEndOnNewPage, Converter={StaticResource B2V}}" />
                                <StackPanel Visibility="{Binding UsesChangeThreshold, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.ChangedWords}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding ChangedWords, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                                    <TextBlock Text="{loc:T Field.SourceChars}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding SourceChars, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                                    <TextBlock Text="{loc:T Hint.ChangedWords}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding UsesEndText, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.Until}" Style="{StaticResource Caption}" Margin="0,16,0,4" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{x:Static m:Options.Matches}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding UntilMode}" HorizontalAlignment="Stretch" />
                                    <TextBox Text="{Binding UntilText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                    <TextBlock Text="{loc:T Hint.EndText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox Content="{loc:T Opt.Negate}" IsChecked="{Binding Negate}" Margin="0,12,0,0"
                                          Visibility="{Binding UsesNegate, Converter={StaticResource B2V}}" />
                                <CheckBox Content="{loc:T Opt.Continue}" IsChecked="{Binding ContinueOnError}" Margin="0,12,0,0"
                                          Visibility="{Binding UsesContinueOnError, Converter={StaticResource B2V}}" />

                                <StackPanel Visibility="{Binding UsesPackage, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.Package}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding Package, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="{loc:T Opt.Autostart}" IsChecked="{Binding Autostart}" Margin="0,8,0,0" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding UsesTimeout, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{Binding TimeoutLabel}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding UsesDelay, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.Delay}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding UsesMoveDuration, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.Move}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding MoveMs, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Content="{loc:T Opt.MoveForever}" IsChecked="{Binding MoveForever}" Margin="0,12,0,0"
                                          Visibility="{Binding UsesMoveForever, Converter={StaticResource B2V}}" />
                                <TextBlock Text="{loc:T Hint.MoveForever}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding MoveForever, Converter={StaticResource B2V}}" />

                                <StackPanel Visibility="{Binding UsesScript, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{loc:T Field.Script}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100"
                                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="10" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Browser -->
            <TabControl x:Name="BrowserTabs" Grid.Column="2" />
        </Grid>

        <GridSplitter x:Name="LogSplitter" Grid.Row="2" Height="10" Background="Transparent" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />

        <!-- Log and results: folded to the tab headers until a header is clicked -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
          <Grid>
            <TextBlock x:Name="LogChevron" Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,9,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" Panel.ZIndex="1" />
            <TabControl x:Name="LogTabs" BorderThickness="0" Background="Transparent" PreviewMouseLeftButtonDown="OnLogTabClick">
                <TabItem Header="{loc:T Tab.Log}">
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" />
                </TabItem>
                <TabItem x:Name="ResultsTab" Header="{loc:T Tab.Results}">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                            <Button Style="{StaticResource LabelButton}" Click="OnSaveResults">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T Results.Save}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LabelButton}" Click="OnSendResultsToJDownloader">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE898;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T Results.SendJd}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LabelButton}" Click="OnClearResults">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T Results.Clear}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <ListView x:Name="ResultsList" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{loc:T Col.Text}" Width="300" DisplayMemberBinding="{Binding Text}" />
                                    <GridViewColumn Header="{loc:T Col.Href}" Width="450" DisplayMemberBinding="{Binding Href}" />
                                    <GridViewColumn Header="{loc:T Col.Page}" Width="350" DisplayMemberBinding="{Binding Page}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>
            </TabControl>
          </Grid>
        </Border>
    </Grid>
</Window>
